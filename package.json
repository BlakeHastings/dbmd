{
  "name": "dbmd",
  "version": "0.0.0",
  "description": "Model your database in markdown, edit it in a local web view, commit the result.",
  "keywords": [
    "database",
    "schema",
    "erd",
    "markdown",
    "documentation",
    "data-modeling",
    "cli"
  ],
  "license": "MIT",
  "author": "Blake Hastings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlakeHastings/dbmd.git"
  },
  "homepage": "https://github.com/BlakeHastings/dbmd#readme",
  "bugs": {
    "url": "https://github.com/BlakeHastings/dbmd/issues"
  },
  "type": "module",
  "private": true,
  "bin": {
    "dbmd": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "default": "./dist/studio/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "studio": "npm run build && node dist/cli.js studio examples/shop",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "check": "npm run typecheck && npm run format:check && npm run check:adr && npm run check:reviewable && npm run test && npm run build && npm run check:pack",
    "check:adr": "node scripts/check-adr-numbers.mjs",
    "check:reviewable": "node scripts/check-reviewable.mjs",
    "check:pack": "node scripts/smoke-pack.mjs",
    "backlog": "bd export -o .beads/issues.jsonl"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
