node_modules/
dist/
coverage/

# The studio client built with the feedback overlay in it, by
# `node scripts/build-client.mjs --dev`. It is a build output like `dist/`, and
# it is deliberately not under `dist/`: `files` in package.json is `["dist"]`,
# so a sibling directory is one npm cannot pack. ADR 0064.
.studio-dev/
*.tsbuildinfo
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Agent worktrees are created inside the repo and would otherwise show up
# as untracked in every git status on the default branch.
.claude/worktrees/

# Screenshots and snapshots left behind by driving the studio in a browser,
# which docs/process/review.md asks a reviewer to do. Evidence, not source.
.playwright-cli/

# `npm pack` with no --pack-destination writes the tarball here. ADR 0024 makes
# packing part of `npm run check`, which packs into a temp directory, but the
# bare command is the obvious thing to type when you want to look inside one.
*.tgz
